# Copy to .env.local for local development.
#
# Every NEXT_PUBLIC_* var is inlined at BUILD time, so setting one here
# only affects local dev. For production it must also be set in the
# hosting project's environment variables and the site redeployed.

# --- Site --------------------------------------------------------------
# Canonical origin, used for canonical URLs, share images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://curogrid.com

# Where the app itself lives, for the login and free-trial buttons.
NEXT_PUBLIC_APP_URL=https://app.curogrid.com

# Sales and support contact. Defaults live in lib/site.ts.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- PostHog -----------------------------------------------------------
# Project API key (public, write-only). With no key set, nothing loads.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Contact form ------------------------------------------------------
# Where /api/contact delivers. Until this is set the form says so and
# points people at WhatsApp, rather than pretending a message was sent.
CONTACT_WEBHOOK_URL=
