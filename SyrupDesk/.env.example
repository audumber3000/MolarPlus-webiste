# Copy to .env.local for local development.
#
# Every NEXT_PUBLIC_* var is inlined at BUILD time, so setting one here
# only affects local dev. For production it must also be set in the
# hosting project's environment variables and the site redeployed.

# --- PostHog -----------------------------------------------------------
# SyrupDesk's OWN PostHog project — not the MolarPlus one. Different
# product, different buyer, different funnel; sharing a project would
# mean filtering every chart before it meant anything.
#
# Project API key: PostHog → Settings → Project → Project API key.
# It is a public, write-only key and is meant to ship in the browser
# bundle. Do NOT put a personal API key here.
#
# SyrupDesk's project is id 568297, on the US region. The real value
# lives in .env.local locally and in the hosting project's environment
# variables in production — left blank here on purpose.
NEXT_PUBLIC_POSTHOG_KEY=
# Region host: https://us.i.posthog.com or https://eu.i.posthog.com.
# Must match the region the project was created in, or events 401.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Site --------------------------------------------------------------
# Canonical origin, used for canonical URLs, OG images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://syrupdesk.com

# Sales and support contact. Defaults live in lib/site.ts.
NEXT_PUBLIC_WHATSAPP=919594078777
NEXT_PUBLIC_SUPPORT_PHONE=+918766742410
NEXT_PUBLIC_SUPPORT_EMAIL=support@syrupdesk.com

# Where the app itself lives, for the login and signup CTAs.
NEXT_PUBLIC_APP_URL=https://app.syrupdesk.com
